# Copie para ".env" (mesma pasta deste arquivo, ao lado do
# docker-compose.yml) e preencha valores reais — nunca commitar o .env de
# verdade (já coberto pelo .gitignore). Mesmo padrão do RE7S.

POSTGRES_PASSWORD=troque-por-uma-senha-forte-e-unica

# String longa e aleatória — usada para assinar os cookies de sessão.
# Gerar uma nova com: python -c "import secrets; print(secrets.token_hex(32))"
CORE_SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio

# Administrador máximo criado automaticamente no primeiro boot (fica
# protegido/imutável depois — ver Prompt_Horun_Core.md, seção 6).
CORE_BOOTSTRAP_ADMIN_USERNAME=admin
CORE_BOOTSTRAP_ADMIN_PASSWORD=troque-por-uma-senha-forte-tambem

# E-mail de notificações importantes (menção, resposta, digest semanal de
# aniversários). Opcional — sem SMTP_HOST, o e-mail fica desligado e nada
# quebra. Recomendado: Gmail dedicado + senha de app
# (https://myaccount.google.com/apppasswords, com 2FA ligado).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=nqtr.horun@gmail.com
SMTP_PASS=senha-de-app-de-16-caracteres
SMTP_FROM=nqtr.horun@gmail.com
