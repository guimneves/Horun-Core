# Mesmo padrão do RE7S (Rock Eval Horun Dev/deploy/Caddyfile) — TLS
# self-signed automático via "tls internal" (decisão registrada em
# Prompt_Horun_Core.md, seção 9.3). Este é o ÚNICO ponto de entrada público da
# plataforma: nem o backend do Core, nem o de nenhum módulo, expõem porta
# ao host — só este proxy.
:443 {
	# "on_demand": obrigatório aqui porque o site é um catch-all (só porta,
	# sem hostname) — sem isso o Caddy não sabe pra qual nome/IP gerar
	# certificado de antemão, e o handshake TLS falha com "internal error"
	# em qualquer conexão (confirmado em produção na DESKTOP-N6KR7DO).
	tls internal {
		on_demand
	}

	# Cabeçalhos de segurança em toda resposta (Core e módulos):
	# - nosniff: o navegador nunca "adivinha" o tipo de um arquivo enviado
	#   (ex. um HTML disfarçado de imagem no Mural não vira página);
	# - SAMEORIGIN: nenhum outro site pode embutir o Horun num iframe;
	# - Referrer-Policy: links para fora não levam o caminho interno.
	# Sem HSTS por enquanto: com certificado self-signed ele só atrapalharia
	# (ver Prompt_Horun_Core.md, seção 8.3, item 1).
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Tudo sob /api vai pro backend do Core (prefixo removido antes de
	# chegar lá — nenhuma rota do FastAPI usa "/api" nesse nível, exceto
	# dentro de /m/{id}/..., que é outro caso, abaixo).
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# /m/{id}/... vai pro backend do Core SEM remover o prefixo — a rota
	# /m/{module_id}/{path} (app/api/routes_proxy.py) espera o caminho
	# inteiro, e decide sozinha se é API ou interface (estáticos) do
	# módulo, e pra qual container encaminhar.
	handle /m/* {
		reverse_proxy backend:8000
	}

	# Tudo mais é o frontend do Core (React/Vite) já buildado como estáticos.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

:80 {
	redir https://{host}{uri} permanent
}
